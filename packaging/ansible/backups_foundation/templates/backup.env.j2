# {{ ansible_managed }}
# Rendered by backups_foundation. Sourced by restic_backup_v1.sh — shell syntax.
BACKUP_REPO="{{ backups_repo }}"
BACKUP_PASSFILE="{{ backups_passfile }}"
BACKUP_PATHS="{{ backups_paths }}"
BACKUP_EXCLUDES="{{ backups_excludes }}"
BACKUP_EXCLUDE_FILE="{{ backups_exclude_file }}"
BACKUP_TAG="{{ backups_tag }}"

RESTIC_BIN="{{ backups_restic_bin }}"
RESTIC_VERSION="{{ backups_restic_version }}"
RESTIC_SHA256="{{ backups_restic_sha256 }}"

GOMAXPROCS="{{ backups_gomaxprocs }}"
NICE="{{ backups_nice }}"
IONICE_CLASS="{{ backups_ionice_class }}"

KEEP_HOURLY="{{ backups_keep_hourly }}"
KEEP_DAILY="{{ backups_keep_daily }}"
KEEP_WEEKLY="{{ backups_keep_weekly }}"
KEEP_MONTHLY="{{ backups_keep_monthly }}"

# DB slice (used by db-backup / db-dump)
BACKUP_DB_STAGE="{{ backups_db_stage }}"
BACKUP_DB_DUMP_DIR="{{ backups_db_dump_dir }}"
MARIABACKUP_BIN="{{ backups_mariabackup_bin }}"

# Restore-drill (used by restore-drill)
BACKUP_DRILL_FILE="{{ backups_drill_file }}"
BACKUP_DRILL_DB_IMPORT="{{ '1' if backups_drill_db_import | bool else '0' }}"
BACKUP_DRILL_DB_BUDGET_BYTES="{{ backups_drill_db_budget_bytes }}"
BACKUP_DRILL_SCRATCH="{{ backups_drill_scratch }}"
