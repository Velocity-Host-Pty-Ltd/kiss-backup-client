# {{ ansible_managed }}
# vps-baseline backups_foundation — nightly mariabackup FULL (new local generation
# base). Hot/read-only on the live instance; kept LOCAL (not shipped to restic).
[Unit]
Description=vps-baseline DB physical full backup (local)
After=mariadb.service
{% if backups_alert_on_check_failure | bool %}
OnFailure=vps-service-alert@%n.service
{% endif %}

[Service]
Type=oneshot
ExecStart={{ backups_engine_path }} db-backup full
{% if backups_alert_on_check_failure | bool %}
# All-clear: a clean start after a prior failure emits the one-shot RECOVERED notice
# + clears the flag ('-' = never fail the unit on it; silent if it wasn't alerting).
ExecStartPost=-{{ backups_watchdog_helper_path }} recover service-failed-%n
{% endif %}
