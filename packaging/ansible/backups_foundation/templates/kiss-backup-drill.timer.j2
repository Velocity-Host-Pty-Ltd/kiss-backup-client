# {{ ansible_managed }}
# vps-baseline backups_foundation — weekly restore-drill schedule (off-hours,
# after the backup/check/prune timers so it verifies fresh backups).
[Unit]
Description=KISS Backup restore-drill (scheduled)

[Timer]
OnCalendar={{ backups_drill_oncalendar }}
RandomizedDelaySec={{ backups_randomized_delay }}
Persistent=true

[Install]
WantedBy=timers.target
