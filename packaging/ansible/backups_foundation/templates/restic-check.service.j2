# {{ ansible_managed }}
# vps-baseline backups_foundation — weekly restic integrity check (the automated
# DETECTION half; handover §13 recovery model). A non-zero exit (damaged repo)
# triggers OnFailure -> the service_watchdog alert template -> notification framework.
[Unit]
Description=vps-baseline restic integrity check
After=network-online.target
Wants=network-online.target
{% if backups_alert_on_check_failure | bool %}
OnFailure=vps-service-alert@%n.service
{% endif %}

[Service]
Type=oneshot
ExecStart={{ backups_engine_path }} check
{% if backups_alert_on_check_failure | bool %}
# All-clear: a clean check after a prior failure emits the one-shot RECOVERED notice
# + clears the flag ('-' = never fail the unit on it; silent if it wasn't alerting).
ExecStartPost=-{{ backups_watchdog_helper_path }} recover service-failed-%n
{% endif %}
